{
  "uid": "casino-wallet",
  "title": "Casino Wallet · Operations",
  "description": "Optional local metrics. Financial truth remains in PostgreSQL. Rates need at least two scrapes; counters reset with the backend process.",
  "tags": [
    "casino-wallet"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Backend scrape",
      "type": "stat",
      "description": "Prometheus can scrape the backend; this is not a database connectivity check.",
      "datasource": {
        "type": "prometheus",
        "uid": "casino-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "casino-prometheus"
          },
          "expr": "min(up{job=\"casino-wallet\"})",
          "legendFormat": "Backend",
          "range": true
        }
      ]
    },
    {
