        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "casino-prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"casino-wallet\",uri=~\"/api/.*\",status=~\"4..\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "4xx",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "casino-prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"casino-wallet\",uri=~\"/api/.*\",status=~\"5..\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "5xx",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "title": "Application latency",
      "type": "timeseries",
      "description": "Latency of /api requests. No traffic means no latency estimate; histogram quantile is approximate.",
      "datasource": {
        "type": "prometheus",
        "uid": "casino-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "casino-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"casino-wallet\",uri=~\"/api/.*\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "casino-prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_sum{job=\"casino-wallet\",uri=~\"/api/.*\"}[$__rate_interval])) / sum(rate(http_server_requests_seconds_count{job=\"casino-wallet\",uri=~\"/api/.*\"}[$__rate_interval]))",
          "legendFormat": "Mean",
          "range": true
        }
      ]
    },
